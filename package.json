{
  "name": "@djankies/vitest-mcp",
  "version": "0.6.0",
  "description": "A Model Context Protocol server for Vitest test execution and management",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "vitest-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/postbuild.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run src/tools",
    "test-coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "publish:beta": "npm run ci && npm version prerelease --preid=beta && git push origin develop --tags && npm publish --tag beta",
    "publish:release": "npm run ci && npm version patch && git push origin develop --tags && npm publish",
    "prepare": "husky",
    "test:compat": "npm run build && node compat/run-compat.mjs"
  },
  "keywords": [
    "mcp",
    "vitest",
    "testing",
    "llm",
    "ai"
  ],
  "author": "djankies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djankies/vitest-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "vitest": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "CLAUDE.example.md"
  ]
}
